[project]
name = "{{ python_package_name }}"
version = "{{ project_version }}"
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
dependencies = [
]

[dependency-groups]
doc = [
]
dev = [
]

{% if 'pkg' in component -%}
[project.scripts]
{{python_package_name}} = "{{python_package_name|replace("-","_")}}:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
{%- endif %}

[tool.uv]
default-groups = ["doc", "dev"]